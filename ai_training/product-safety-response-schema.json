{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductSafetyAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk_level",
    "matched_additives",
    "warnings",
    "safe_summary",
    "confidence"
  ],
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "matched_additives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matched_text",
          "canonical_name",
          "code",
          "risk_level",
          "reason"
        ],
        "properties": {
          "matched_text": {
            "type": "string",
            "minLength": 1
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safe_summary": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
